{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build and compile program",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "${workspaceFolder}/src/*",
                "-o",
                "${workspaceFolder}/build/virtual_microprocessor.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "Build and debug program",
            "command": "C:/msys64/ucrt64/bin/gdb.exe",
            "args": [
                "${workspaceFolder}/src/*"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}